# VS Code settings
.vscode/**

# Source files (bundled into out/extension.js and out/webview/board.js)
src/**
**/*.ts

# Source maps (exclude for production, keep for debugging if needed)
**/*.map

# Test outputs
out/test/**

# Node modules (everything is bundled into out/extension.js and out/webview/board.js)
node_modules/**
# Note: All dependencies are bundled, no node_modules needed in VSIX

# Git and version control
.git/**
.gitignore
.gitattributes

# Development files
.DS_Store
*.log
.beads/**

# Release artifacts. release-fork-vsix.sh writes SHA256SUMS after packaging,
# so a leftover from a previous run (or from --dry-run) would otherwise be
# bundled into the next VSIX.
SHA256SUMS
*.vsix

# Local-only working directory (untracked via .git/info/exclude — exclude
# from VSIX too so scratch files don't bloat the package)
.local/**

# Agent tooling config. vsce reads .vscodeignore, not .gitignore, so a file
# being git-ignored does not keep it out of the VSIX — settings.local.json
# shipped in every build up to 2.1.4-bd.5, carrying absolute local paths.
.claude/**
.plannotator/**

# Git worktrees created by orchestrator workflows live at
# worktrees/<branch>-<hash>/ alongside the main clone. Excluded from the
# VSIX so the package stays at the ~1.1 MB baseline instead of bundling
# every checked-out branch.
worktrees/**

# Documentation & Specs (keep only README, CHANGELOG, LICENSE, PUBLISHING, MIGRATION)
AGENTS.md
ARCHITECTURE_PROPOSAL_FAST_LOADING.md
CLAUDE.md
COMPREHENSIVE_TEST_PLAN.md
CONTRIBUTING.md
External_Dependencies_Review.md
GEMINI.md
SECURITY_REVIEW.md
TESTING_STRATEGY.md
TESTING.md
WEB_EXTENSION_PLAN.md
# Keep CHANGELOG.md, README.md, LICENSE, PUBLISHING.md, MIGRATION.md

# Build & Test Config
.node-version
.vscode-test.mjs
.gitignore
.gitattributes
.vscodeignore
tsconfig.json
inspect_schema.js
*.py

# Test Data & Results
test-screenshots/**
coverage/**
.serena/**
.Archive/**
.Roadmap/**
*-report.md
*-summary.md
test-output*.txt
typescript-*.txt
vsce-*.txt
package-log.txt

# Scripts (unless runtime required, usually built into out/)
scripts/**

# Source Images (keep images/ used by README/icon)
Beads-Kanban-Logo.png
Beads-Kanban-Logo2.png
# Exclude root-level screenshots (keep only images/ folder)
Screenshot*.jpg
Screenshot*.png
Edit Form*.jpg
*.code-workspace

# Output
out/test/**